            "required": [
                "config_path",
                "executable_path",
                "working_directory_path",
                "learn_az_elev_path",
                "sun_intensity_path",
                "motor_offset_threshold",
                "restart_if_logs_are_too_old",
                "restart_if_cover_remains_closed"
